# Copy to client-defaults.env next to deploy-windows-client.ps1 (or leave in the kit).
# Used when -ApiBaseUrl / -WebUrl are not passed on the command line.

# Tray client → Schnapp API (required for login/upload)
ApiBaseUrl=http://schnapp:5080

# Browser UI (optional Start Menu "Schnapp Web" shortcut)
WebUrl=https://schnapp/

# Optional pre-fill login identity (email / code / name)
# LoginIdentity=admin@example.com
