# Copy to defaults.env and edit before build, or pass the same vars on the
# build host / first boot. Lines are sourced by build-appliance.sh and by
# guest tools (schnapp-configure).

# --- Output paths (keep large images off /home / the worktree) ---
# Dated disks + manifest:  $APPLIANCE_ROOT/YYYYMMDD/
# Intermediate publish:    $APPLIANCE_ROOT/.build/
APPLIANCE_ROOT=/opt/schnapp/appliance
# ARTIFACTS=               # optional override for one dated folder
# BUILD_DIR=               # optional override for intermediate publish

# --- Disk format (QNAP Virtualization Station) ---
# QNAP often requires the *filename* to end in .img, but boots qcow2 *content*.
DISK_FORMAT=qcow2
DISK_EXT=img

# --- Image sizes ---
# 8G system: OS + API/Web + Samba + client kits
# 8G data: Postgres + optional local blobs (raise if blobs stay on-disk, no NFS)
SYSTEM_DISK_SIZE=8G
DATA_DISK_SIZE=8G
ALPINE_BRANCH=latest-stable
DOTNET_RID=linux-musl-x64
CLIENT_LINUX_RID=linux-x64
# WINDOWS_CLIENT_KIT=/opt/schnapp/appliance/windows-client-kit

# --- Identity ---
HOSTNAME=schnapp
ROOT_PASSWORD=schnapp
# SSH public keys: scripts/appliance/ssh/authorized_keys.{root,schnapp}
# (survive system image rebuild; see scripts/appliance/ssh/README.md)
# SCHNAPP_SSH_KEYS_DIR=/path/to/dir   # optional override

# --- Network (DHCP; reserve MAC/IP on the NAS/router) ---

# --- Durable data volume (second virtio disk, LABEL=schnapp-data) ---
# Mounted at /opt/schnapp/data — holds postgresql/ and blobs/
DATA_MOUNTPOINT=/opt/schnapp/data
DATA_DISK_LABEL=schnapp-data
# Unversioned single cluster (not …/16/data)
PGDATA=/opt/schnapp/data/postgresql

# --- Blobs (under data volume; optional NFS overmount) ---
# Empty BLOB_NFS = store screenshots on the data disk at BLOB_MOUNTPOINT.
# Set BLOB_NFS to overmount NAS share onto the same path, e.g.:
#   BLOB_NFS=nas:/schnapp/blobs
BLOB_NFS=
BLOB_MOUNTPOINT=/opt/schnapp/data/blobs
BLOB_NFS_OPTS=rw,hard,timeo=100,retrans=2,_netdev
# BLOB_NFS_TYPE=nfs

# --- Database role ---
DB_NAME=schnapp
DB_USER=schnapp
DB_PASSWORD=schnapp

# --- Schnapp app ---
SCHNAPP_PREFIX=/opt/schnapp
API_PORT=5080
# Web UI (Kestrel): HTTP :80 + HTTPS :443 (self-signed cert unless you replace it)
WEB_PORT=80
HTTPS_PORT=443
HTTPS_ENABLE=1
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Backup (prefer under blobs so it lives with screenshots) ---
BACKUP_DIR=/opt/schnapp/data/blobs/_appliance/db
