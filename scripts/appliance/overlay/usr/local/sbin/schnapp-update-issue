#!/bin/sh
# Write /etc/issue (pre-login) and /etc/motd (post-login) with appliance facts.
# Safe under set -e: never use failing "[ -f ] &&" as the last command of a chain.
set -eu

if [ -f /etc/conf.d/schnapp-appliance ]; then
	# shellcheck disable=SC1091
	. /etc/conf.d/schnapp-appliance
fi
if [ -f /etc/schnapp/appliance.env ]; then
	# shellcheck disable=SC1091
	. /etc/schnapp/appliance.env
fi

HOST=$(cat /etc/hostname 2>/dev/null || echo schnapp)
HOST=$(printf '%s' "$HOST" | tr -d '\r\n')
KERNEL=$(uname -r 2>/dev/null || echo unknown)
ARCH=$(uname -m 2>/dev/null || echo unknown)

# Prefer first non-loopback IPv4
IP=""
if command -v ip >/dev/null 2>&1; then
	IP=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1 || true)
fi
if [ -z "$IP" ]; then
	# busybox ip fallback
	IP=$(ip addr show 2>/dev/null | awk '/inet / && $2 !~ /^127\./ { sub(/\/.*/, "", $2); print $2; exit }' || true)
fi
if [ -z "$IP" ] && command -v hostname >/dev/null 2>&1; then
	IP=$(hostname -i 2>/dev/null | awk '{print $1}' || true)
fi
[ -n "$IP" ] || IP="(dhcp pending)"

WEB_PORT="${WEB_PORT:-80}"
HTTPS_PORT="${HTTPS_PORT:-443}"
HTTPS_ENABLE="${HTTPS_ENABLE:-1}"
API_PORT="${API_PORT:-5080}"
DATA_MP="${DATA_MOUNTPOINT:-/opt/schnapp/data}"
BLOB_MP="${BLOB_MOUNTPOINT:-/opt/schnapp/data/blobs}"
BLOB_NFS="${BLOB_NFS:-}"

DATA_STATE="not mounted"
if mountpoint -q "$DATA_MP" 2>/dev/null || mount | grep -q " on ${DATA_MP} "; then
	DATA_STATE="mounted"
fi

BLOB_STATE="local"
if mount | grep " on ${BLOB_MP} " 2>/dev/null | grep -q nfs; then
	BLOB_STATE="nfs ${BLOB_NFS}"
elif [ -n "$BLOB_NFS" ]; then
	BLOB_STATE="nfs configured (${BLOB_NFS}) — check mount"
fi

WEB_LINE="http://${IP}/"
if [ "$HTTPS_ENABLE" != "0" ] && [ "$HTTPS_PORT" != "0" ]; then
	if [ "$HTTPS_PORT" = "443" ]; then
		WEB_LINE="${WEB_LINE}  https://${IP}/"
	else
		WEB_LINE="${WEB_LINE}  https://${IP}:${HTTPS_PORT}/"
	fi
fi
if [ "$WEB_PORT" != "80" ]; then
	WEB_LINE="http://${IP}:${WEB_PORT}/"
	if [ "$HTTPS_ENABLE" != "0" ] && [ "$HTTPS_PORT" != "0" ]; then
		WEB_LINE="${WEB_LINE}  https://${IP}:${HTTPS_PORT}/"
	fi
fi

# BusyBox/agetty: \\ in /etc/issue → one \ on screen. UNC \\IP\share needs \\\\IP\\share in file.
SMB_UNC=$(printf '\\\\\\\\%s\\\\clients' "$IP")

umask 022

# --- pre-login (getty) ---
{
	printf '\n'
	printf 'Schnapp appliance\n'
	printf '  host     %s   kernel %s (%s)\n' "$HOST" "$KERNEL" "$ARCH"
	printf '  ip       %s\n' "$IP"
	printf '  web      %s\n' "$WEB_LINE"
	printf '  api      http://%s:%s/api/v1/health\n' "$IP" "$API_PORT"
	printf '  ssh      ssh root@%s\n' "$IP"
	printf '  smb      %s   (tray install kits)\n' "$SMB_UNC"
	printf '  data     %s (%s)\n' "$DATA_MP" "$DATA_STATE"
	printf '  blobs    %s (%s)\n' "$BLOB_MP" "$BLOB_STATE"
	printf '  login    root (password and/or SSH key) · schnapp (SSH key if installed)\n'
	printf '\n'
} >/etc/issue

# --- post-login (friendly motd; plain text, no getty escapes) ---
# Display UNC for humans: \\IP\clients
SMB_MOTD=$(printf '\\\\%s\\clients' "$IP")
{
	printf '\n'
	printf 'Schnapp appliance (Alpine) — host %s\n' "$HOST"
	printf '  ip       %s\n' "$IP"
	printf '  web      %s\n' "$WEB_LINE"
	printf '  api      http://%s:%s/api/v1/health\n' "$IP" "$API_PORT"
	printf '  ssh      ssh root@%s   (or: ssh schnapp@%s)\n' "$IP" "$IP"
	printf '  smb      %s\n' "$SMB_MOTD"
	printf '  data     %s (%s)\n' "$DATA_MP" "$DATA_STATE"
	printf '  blobs    %s (%s)\n' "$BLOB_MP" "$BLOB_STATE"
	printf '\n'
	printf '  tools    schnapp-status | schnapp-configure --help | schnapp-backup\n'
	printf '  logs     tail -f /var/log/schnapp-api.log /var/log/schnapp-web.log\n'
	printf '  login    root password from image build (example default: schnapp)\n'
	printf '\n'
} >/etc/motd

exit 0
