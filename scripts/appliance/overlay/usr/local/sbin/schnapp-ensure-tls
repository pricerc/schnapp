#!/bin/sh
# Ensure TLS material exists for Kestrel HTTPS (self-signed if missing).
# Usage: schnapp-ensure-tls [--force] [--cn HOSTNAME]
set -eu
# shellcheck source=/usr/local/sbin/schnapp-lib.sh
. /usr/local/sbin/schnapp-lib.sh

schnapp_need_root
schnapp_load_config

FORCE=0
CN="${HOSTNAME:-schnapp}"
TLS_DIR="${TLS_DIR:-/opt/schnapp/config/tls}"
CERT="${TLS_CERT:-$TLS_DIR/cert.pem}"
KEY="${TLS_KEY:-$TLS_DIR/key.pem}"

while [ $# -gt 0 ]; do
	case "$1" in
		--force) FORCE=1; shift ;;
		--cn) CN="$2"; shift 2 ;;
		-h|--help)
			echo "Usage: schnapp-ensure-tls [--force] [--cn NAME]"
			exit 0
			;;
		*) schnapp_die "unknown option: $1" ;;
	esac
done

mkdir -p "$TLS_DIR"
chmod 750 "$TLS_DIR"

if [ "$FORCE" -eq 0 ] && [ -f "$CERT" ] && [ -f "$KEY" ]; then
	schnapp_log "TLS cert already present: $CERT"
	chown -R schnapp:schnapp "$TLS_DIR"
	chmod 640 "$CERT" "$KEY" 2>/dev/null || true
	exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
	apk add --no-cache openssl 2>/dev/null || schnapp_die "openssl required to generate TLS cert"
fi

schnapp_log "generating self-signed TLS cert (CN=${CN}, 825 days)"
openssl req -x509 -newkey rsa:2048 -nodes \
	-keyout "$KEY" \
	-out "$CERT" \
	-days 825 \
	-subj "/CN=${CN}" \
	-addext "subjectAltName=DNS:${CN},DNS:localhost,IP:127.0.0.1" \
	2>/dev/null \
|| openssl req -x509 -newkey rsa:2048 -nodes \
	-keyout "$KEY" \
	-out "$CERT" \
	-days 825 \
	-subj "/CN=${CN}"

chown -R schnapp:schnapp "$TLS_DIR"
chmod 640 "$CERT" "$KEY"
schnapp_log "wrote $CERT and $KEY (replace with a real cert when ready)"
