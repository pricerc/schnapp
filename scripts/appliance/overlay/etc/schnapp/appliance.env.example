# /etc/schnapp/appliance.env — optional runtime overrides (not required if
# baked defaults from image build are enough).
#
# DATA_MOUNTPOINT=/opt/schnapp/data
# PGDATA=/opt/schnapp/data/postgresql
# BLOB_MOUNTPOINT=/opt/schnapp/data/blobs
# BLOB_NFS=nas:/schnapp/blobs
# DB_PASSWORD=...
# ADMIN_EMAIL=...
# ADMIN_PASSWORD=...
