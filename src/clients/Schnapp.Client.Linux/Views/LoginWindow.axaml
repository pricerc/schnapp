<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Schnapp.Client.Linux.Views.LoginWindow"
        Icon="/Assets/app-icon.ico"
        Title="Schnapp — Login"
        Width="320"
        MinWidth="320"
        MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        CanResize="True">
  <DockPanel Margin="20" LastChildFill="True">
    <!-- Buttons always visible at bottom -->
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,16,0,0">
      <Button x:Name="LoginButton" Content="Sign in" MinWidth="88" Click="OnLogin" IsDefault="True" HorizontalContentAlignment="Center"/>
      <Button Content="Cancel" MinWidth="88" Click="OnCancel" IsCancel="True" HorizontalContentAlignment="Center"/>
    </StackPanel>

    <!-- Status / error above buttons (room for multi-line errors) -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0" MinHeight="48">
      <TextBlock x:Name="ErrorText"
                 Foreground="#e06c75"
                 TextWrapping="Wrap"
                 MaxHeight="96"
                 IsVisible="False"/>
      <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Text="Sign in to Schnapp" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Email, code, or name. Password optional for passwordless accounts."
                 Opacity="0.7" TextWrapping="Wrap"/>

      <TextBlock Text="API server"/>
      <TextBox x:Name="ServerBox" PlaceholderText="http://127.0.0.1:5080"/>

      <TextBlock Text="Login"/>
      <TextBox x:Name="LoginBox" PlaceholderText="you@example.com or code"/>

      <TextBlock Text="Password"/>
      <TextBox x:Name="PasswordBox" PasswordChar="•" PlaceholderText="(optional)"/>
    </StackPanel>
  </DockPanel>
</Window>
