<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Schnapp.Client.Linux.Controls"
        x:Class="Schnapp.Client.Linux.Views.MainWindow"
        Icon="/Assets/app-icon.ico"
        Title="Schnapp"
        Width="280" Height=""
        MinWidth="260" MinHeight="360"
        WindowStartupLocation="Manual">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#1a2332" Padding="6,4">
      <TextBlock x:Name="StatusBar" FontSize="11" Opacity="0.85" TextWrapping="Wrap"
                 Text="Ready"/>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" Background="#121820">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button x:Name="RefreshBtn" Content="↻" Width="36" Height="32"
                  ToolTip.Tip="Refresh lists from server" Click="OnRefresh"/>
          <Button x:Name="SnapshotBtn" Content="★" Width="36" Height="32"
                  ToolTip.Tip="Capture now" Click="OnSnapshot"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <Button x:Name="StartCaptureBtn" Content="▶" Width="36" Height="32"
                  ToolTip.Tip="Start capture timer" Click="OnStartCapture"/>
          <Button x:Name="StopCaptureBtn" Content="■" Width="36" Height="32"
                  ToolTip.Tip="Pause capture timer" Click="OnStopCapture"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="10" Spacing="8">
        <Border Background="#1e3a5f" CornerRadius="6" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock x:Name="ActiveTargetText" FontSize="15" FontWeight="SemiBold"
                       Text="No active target" TextWrapping="Wrap"/>
            <TextBlock x:Name="ActiveTimeText" FontSize="12" Opacity="0.9"
                       Text="—" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- <TextBlock Text="Recent targets" Opacity="0.7" FontSize="11"/> -->
        <ComboBox x:Name="MruBox" HorizontalAlignment="Stretch"
                  PlaceholderText="Pick a recent target…"
                  SelectionChanged="OnMruSelected"/>

        <Separator/>

        <!-- <TextBlock Text="Customer" Opacity="0.7" FontSize="11"/> -->
        <ComboBox x:Name="CustomerBox" HorizontalAlignment="Stretch"
                  IsEditable="True" PlaceholderText="Type or select customer…"/>

        <!-- <TextBlock Text="Project" Opacity="0.7" FontSize="11"/> -->
        <ComboBox x:Name="ProjectBox" HorizontalAlignment="Stretch"
                  IsEditable="True" PlaceholderText="Type or select project…"/>

        <!-- <TextBlock Text="Task" Opacity="0.7" FontSize="11"/> -->
        <ComboBox x:Name="TaskBox" HorizontalAlignment="Stretch"
                  IsEditable="True" PlaceholderText="Type or select task…"/>

        <!-- <TextBlock Text="Tags" Opacity="0.7" FontSize="11"/> -->
        <controls:TagsInput x:Name="TagsBox"
                            PlaceholderText="Tags - e.g. billing, meeting, research…"
                            MaxLength="500"
                            LostFocusTags="OnTagsLostFocus"/>

        <!-- <TextBlock Text="Notes" Opacity="0.7" FontSize="11"/> -->
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="72" MaxLength="500" VerticalAlignment="Stretch"
                 PlaceholderText="Optional notes for this journal…"
                 LostFocus="OnNotesLostFocus"/>

        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <Button Grid.Column="0" Content="Apply" Click="OnApplyTarget"
                  HorizontalAlignment="Stretch" Margin="0,0,6,0"
                  HorizontalContentAlignment="Center" 
                  ToolTip.Tip="Start journal with the selected customer/project/task (creates missing names)"/>
          <Button Grid.Column="1" Content="Clear" Click="OnClearTarget" MinWidth="72"
                  HorizontalContentAlignment="Center" 
                  ToolTip.Tip="Stop open journal (target none)"/>
        </Grid>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
