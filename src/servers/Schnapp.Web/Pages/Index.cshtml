<dialog id="shot-viewer" class="viewer-dialog">
    <div id="viewer-head" class="viewer-head">
        <strong id="viewer-meta">Screenshot</strong>
        <div id="viewer-nav" class="viewer-nav">
            <button type="button" class="secondary small" id="viewer-prev" title="Previous image (←)">←</button>
            <button type="button" class="secondary small" id="viewer-next" title="Next image (→)">→</button>
            <button type="button" class="secondary small" id="viewer-batch-prev" title="Previous batch (↑)">↑</button>
            <button type="button" class="secondary small" id="viewer-batch-next" title="Next batch (↓)">↓</button>
            <button type="button" class="secondary small" id="viewer-batch-prev-10" title="Back 10 batches (Page Up)">⇈</button>
            <button type="button" class="secondary small" id="viewer-batch-next-10" title="Forward 10 batches (Page Down)">⇊</button>
            <button type="button" class="secondary small" id="viewer-zoom-out" title="Zoom out">-</button>
            <button type="button" class="secondary small" id="viewer-zoom-reset" title="Reset zoom">1:1</button>
            <button type="button" class="secondary small" id="viewer-zoom-in" title="Zoom in">+</button>
            <a id="viewer-open-tab" class="btn secondary small btn-with-icon" href="#" target="_blank" rel="noopener"
               title="Open full image in a new tab">
                <partial name="_Icon" model='"external"' /><span>New tab</span>
            </a>
            <form id="viewer-close-form" method="dialog" class="inline-form">
                <button type="submit" class="secondary small btn-with-icon" id="viewer-close" data-viewer-close>
                    <partial name="_Icon" model='"close"' /><span>Close</span>
                </button>
            </form>
        </div>
    </div>
    <div id="viewer-body" class="viewer-body">
        <div id="viewer-pan" class="viewer-image-wrap" title="Drag to pan when zoomed">
            <img id="viewer-img" alt="screenshot" draggable="false" />
        </div>
        <aside id="viewer-side" class="viewer-side">
            <dl id="viewer-details" class="viewer-readonly">
                <div id="viewer-detail-when"><dt>Captured</dt><dd id="viewer-when">—</dd></div>
                <div id="viewer-detail-machine"><dt>Machine</dt><dd id="viewer-machine">—</dd></div>
                <div id="viewer-detail-monitor"><dt>Monitor</dt><dd id="viewer-monitor">—</dd></div>
                <div id="viewer-detail-window"><dt>Window</dt><dd id="viewer-window">—</dd></div>
                <div id="viewer-detail-program"><dt>Program</dt><dd id="viewer-program">—</dd></div>
                <div id="viewer-detail-size"><dt>Size</dt><dd id="viewer-size">—</dd></div>
                <div id="viewer-detail-type"><dt>Type</dt><dd id="viewer-type">—</dd></div>
                <div id="viewer-detail-tz"><dt>Client TZ</dt><dd id="viewer-tz">—</dd></div>
                <div id="viewer-detail-received"><dt>Received</dt><dd id="viewer-received">—</dd></div>
            </dl>
            <form id="viewer-edit-form" method="post" asp-page="/Index" data-disable-on-submit>
                <input type="hidden" id="viewer-form-date" name="date" value="@Model.Date" />
                <input type="hidden" id="viewer-form-monitor" name="monitor" value="@Model.MonitorFilter" />
                <input type="hidden" id="viewer-form-machine" name="Machine" value="@Model.MachineFilter" />
                <input type="hidden" id="viewer-form-from" name="FromTime" value="@Model.FromTimeFilter" />
                <input type="hidden" id="viewer-form-to" name="ToTime" value="@Model.ToTimeFilter" />
                <input type="hidden" name="Journal" value="@Model.JournalFilter" />
                <input type="hidden" name="TagsQ" value="@Model.TagsFilter" />
                <input type="hidden" name="Customer" value="@Model.CustomerFilter" />
                <input type="hidden" name="Project" value="@Model.ProjectFilter" />
                <input type="hidden" name="Task" value="@Model.TaskFilter" />
                <input type="hidden" name="GroupBy" value="@Model.GroupByNormalized" />
                <input type="hidden" id="viewer-date" name="ViewerDate" value="@Model.Date" />
                <input type="hidden" id="viewer-id" name="ViewerId" />
                <input type="hidden" id="viewer-machine-id" value="" />
                <div class="field-stack viewer-journal-field">
                    <div class="field-label-row">
                        <label for="viewer-journal-label">Linked journal</label>
                        <button type="button" id="viewer-edit-journal" class="btn-with-icon secondary small"
                                title="Change this image's linked journal (None is allowed)">
                            <partial name="_Icon" model='"edit"' /><span>Edit</span>
                        </button>
                    </div>
                    <input type="hidden" id="viewer-journal" name="ViewerJournalEntryId" />
                    <input type="text" id="viewer-journal-label" class="viewer-journal-readonly" readonly
                           placeholder="None" tabindex="-1" />
                    <p id="viewer-covering-hint" class="muted viewer-covering-hint" hidden></p>
                </div>
                <div class="viewer-tags-notes">
                    <div class="field-stack">
                        <label for="viewer-tags">Tags</label>
                        <input id="viewer-tags" name="ViewerTags" data-tags-autocomplete autocomplete="off" />
                    </div>
                    <div class="field-stack field-notes">
                        <label for="viewer-notes">Notes</label>
                        <textarea id="viewer-notes" name="ViewerNotes" rows="3"></textarea>
                    </div>
                </div>
                <div id="viewer-actions" class="form-actions">
                    <button id="viewer-save" type="submit" class="btn-with-icon"
                            formaction="@Url.Page("/Index", "SaveViewer")">
                        <partial name="_Icon" model='"save"' /><span>Save</span>
                    </button>
                    <button id="viewer-save-close" type="submit" class="btn-with-icon secondary"
                            formaction="@Url.Page("/Index", "SaveViewerAndClose")">
                        <partial name="_Icon" model='"save-close"' /><span>Save and close</span>
                    </button>
                    <button id="viewer-delete" type="submit" class="btn-with-icon danger"
                            formaction="@Url.Page("/Index", "DeleteViewer")"
                            formnovalidate
                            data-confirm="Delete this screenshot? This cannot be undone.">
                        <partial name="_Icon" model='"trash"' /><span>Delete</span>
                    </button>
                    <button id="viewer-close-side" type="submit" class="btn-with-icon secondary"
                            formmethod="dialog" formnovalidate data-viewer-close>
                        <partial name="_Icon" model='"close"' /><span>Close</span>
                    </button>
                </div>
                <p id="viewer-hint" class="muted viewer-hint">← → image · ↑ ↓ batch · PgUp/PgDn ±10 batches · +/- zoom · drag to pan · Esc close</p>
                <p id="viewer-shot-id" class="entity-id viewer-shot-id">Id: <code>—</code></p>
            </form>
        </aside>
    </div>
    <div id="viewer-resize-hint" class="viewer-resize-hint" aria-hidden="true"></div>
</dialog>

<partial name="_JournalEditor" model="Model.JournalEditors" />
<partial name="_JournalTargetEditor" model="Model.JournalEditors" />
