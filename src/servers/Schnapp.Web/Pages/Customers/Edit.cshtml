@page "/Customers/{code}"
@using Schnapp.Domain
@model Schnapp.Web.Pages.Customers.EditModel
@{
    ViewData["Title"] = Model.Customer?.Name ?? "Customer";
    ViewData["Wide"] = true;
}

<p class="muted"><a href="/Customers">← Customers</a></p>
<partial name="_Flash" model="(Model.Message, Model.Error)" />

@if (Model.Customer is not null)
{
    <div class="card">
        <h1>@Model.Customer.Name</h1>
        <form method="post" asp-page-handler="Save" data-disable-on-submit>
            <div class="entity-fields">
                <div class="entity-col entity-col-left">
                    <div class="field-row">
                        <label asp-for="Input.Code">Code</label>
                        <input asp-for="Input.Code" />
                    </div>
                    <div class="field-row">
                        <label asp-for="Input.Name">Name</label>
                        <input asp-for="Input.Name" />
                    </div>
                    <div class="field-row">
                        <label asp-for="Input.Tags">Tags</label>
                        <input asp-for="Input.Tags" />
                    </div>
                </div>
                <div class="entity-col entity-col-right">
                    <div class="field-row">
                        <label asp-for="Input.Status">Status</label>
                        <select asp-for="Input.Status">
                            @foreach (var (value, label) in ListEntityStatus.All)
                            {
                                if (Model.Input.Status == value)
                                {
                                    <option value="@value" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@value">@label</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="field-row">
                        <label asp-for="Input.ColourCode">Colour</label>
                        <div class="colour-field">
                            <input type="color" value="@(string.IsNullOrWhiteSpace(Model.Input.ColourCode) || Model.Input.ColourCode[0] != '#' ? "#5b9fd4" : Model.Input.ColourCode)" aria-label="Colour swatch" />
                            <input asp-for="Input.ColourCode" type="text" placeholder="#rrggbb or name" />
                        </div>
                    </div>
                </div>
                <div class="field-row field-notes-row entity-notes-span">
                    <label asp-for="Input.Notes">Notes</label>
                    <textarea asp-for="Input.Notes" rows="3"></textarea>
                </div>
            </div>
            <div class="entity-footer">
                <div class="form-actions">
                    <button type="submit" class="btn-with-icon" formaction="?handler=Save">
                        <partial name="_Icon" model='"save"' /><span>Save</span>
                    </button>
                    <button type="submit" class="btn-with-icon secondary" formaction="?handler=SaveAndClose">
                        <partial name="_Icon" model='"save-close"' /><span>Save and close</span>
                    </button>
                    <a class="btn btn-with-icon secondary" href="/Customers">
                        <partial name="_Icon" model='"close"' /><span>Close</span>
                    </a>
                </div>
                <p class="entity-id">Id: <code>@Schnapp.Contracts.Uuid7Text.Format(Model.Customer.Id)</code></p>
            </div>
        </form>
    </div>

    <details class="card collapsible-card" open>
        <summary class="collapsible-summary">
            <span>
                <h2 style="display:inline;margin:0">Customer tags</h2>
                <span class="muted"> · @Model.CustomerTags.Count</span>
            </span>
        </summary>
        <p class="muted" style="margin:0.5rem 0 0.75rem">
            Tags specific to this customer (for autocomplete). Tags that already exist as
            <a href="/Tags">general tags</a> cannot be duplicated here — move to general instead.
        </p>
        <div class="table-wrap">
            <table class="data-grid tag-dict-grid">
                <thead>
                    <tr>
                        <th style="width:14rem">Tag</th>
                        <th colspan="2">Notes</th>
                        <th class="actions" title="Move to general"><span class="sr-only">Move to general</span></th>
                        <th class="actions" title="Delete"><span class="sr-only">Delete</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.CustomerTags)
                {
                    <tr>
                        <td><code>@t.Tag</code></td>
                        <td colspan="2">
                            <form method="post" asp-page-handler="SaveCustomerTagNotes" data-disable-on-submit class="tag-notes-form tag-notes-row">
                                <input type="hidden" name="EditTag" value="@t.Tag" />
                                <input type="text" name="EditTagNotes" value="@t.Notes" class="tag-notes-input" placeholder="Notes…" />
                                <button type="submit" class="icon-btn" title="Save notes for @t.Tag" aria-label="Save notes for @t.Tag">
                                    <partial name="_Icon" model='"save"' />
                                </button>
                            </form>
                        </td>
                        <td class="actions">
                            <form method="post" asp-page-handler="MakeCustomerTagGlobal" data-disable-on-submit class="inline-form">
                                <input type="hidden" name="EditTag" value="@t.Tag" />
                                <button type="submit" class="icon-btn" title="Move @t.Tag to general tags" aria-label="Move @t.Tag to general tags"
                                        data-confirm="Move tag @t.Tag to the general (org-wide) list?">
                                    <partial name="_Icon" model='"external"' />
                                </button>
                            </form>
                        </td>
                        <td class="actions">
                            <form method="post" asp-page-handler="DeleteCustomerTag" data-disable-on-submit class="inline-form">
                                <input type="hidden" name="EditTag" value="@t.Tag" />
                                <button type="submit" class="icon-btn danger" title="Delete @t.Tag" aria-label="Delete @t.Tag"
                                        data-confirm="Delete customer tag @t.Tag?">
                                    <partial name="_Icon" model='"trash"' />
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.CustomerTags.Count == 0)
                {
                    <tr><td colspan="5" class="muted">No customer-specific tags yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
        <form method="post" asp-page-handler="CreateCustomerTag" data-disable-on-submit class="tag-add-form">
            <h3 class="section-subhead">Add customer tag</h3>
            <div class="entity-fields entity-fields-tags-notes">
                <div class="field-row">
                    <label asp-for="NewCustomerTag">Tag</label>
                    <input asp-for="NewCustomerTag" autocomplete="off" placeholder="single token" />
                </div>
                <div class="field-row">
                    <label asp-for="NewCustomerTagNotes">Notes</label>
                    <input asp-for="NewCustomerTagNotes" placeholder="optional" />
                </div>
            </div>
            <div class="form-actions" style="margin-top:0.75rem">
                <button type="submit" class="btn-with-icon">
                    <partial name="_Icon" model='"plus"' /><span>Add tag</span>
                </button>
            </div>
        </form>
    </details>

    <div class="card">
        <div class="page-head">
            <div>
                <h2 style="margin-bottom:0.25rem">Projects</h2>
                <p class="muted" style="margin:0">Project code is unique within this customer.</p>
            </div>
            <button type="button" class="btn-with-icon" data-open-dialog="create-project-dialog">
                <partial name="_Icon" model='"plus"' /><span>Add project</span>
            </button>
        </div>
        <div class="table-wrap">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Code</th><th>Name</th><th>Tags</th><th>Notes</th>
                        @if (Model.IsAdmin) { <th>Id</th> }
                        <th class="actions" title="Edit"><span class="sr-only">Edit</span></th>
                        <th class="actions" title="Delete"><span class="sr-only">Delete</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Projects)
                {
                    <tr>
                        <td><code>@p.Code</code></td>
                        <td>@p.Name</td>
                        <td class="muted">@p.Tags</td>
                        <td class="muted">@p.Notes</td>
                        @if (Model.IsAdmin) { <td><code>@Schnapp.Contracts.Uuid7Text.Format(p.Id)</code></td> }
                        <td class="actions">
                            <a class="icon-btn" href="/Customers/@Uri.EscapeDataString(Model.Customer.Code)/Projects/@Uri.EscapeDataString(p.Code)"
                               title="Edit @p.Name" aria-label="Edit @p.Name">
                                <partial name="_Icon" model='"edit"' />
                            </a>
                        </td>
                        <td class="actions">
                            @if (p.Id != WellKnownIds.None)
                            {
                                <form method="post" asp-page-handler="DeleteProject" asp-route-id="@Schnapp.Contracts.Uuid7Text.Format(p.Id)" class="inline-form">
                                    <button type="submit" class="icon-btn danger" title="Delete @p.Code" aria-label="Delete @p.Code"
                                            data-confirm="Delete project @p.Code?">
                                        <partial name="_Icon" model='"trash"' />
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Projects.Count == 0)
                {
                    <tr><td colspan="6" class="muted">No projects yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="page-head">
            <div>
                <h2 style="margin-bottom:0.25rem">Customer tasks</h2>
                <p class="muted" style="margin:0">Tasks not tied to a project. Code unique within customer.</p>
            </div>
            <button type="button" class="btn-with-icon" data-open-dialog="create-customer-task-dialog">
                <partial name="_Icon" model='"plus"' /><span>Add task</span>
            </button>
        </div>
        <div class="table-wrap">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Code</th><th>Name</th><th>Tags</th><th>Notes</th>
                        @if (Model.IsAdmin) { <th>Id</th> }
                        <th class="actions" title="Edit"><span class="sr-only">Edit</span></th>
                        <th class="actions" title="Delete"><span class="sr-only">Delete</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.CustomerTasks)
                {
                    <tr>
                        <td><code>@t.Code</code></td>
                        <td>@t.Name</td>
                        <td class="muted">@t.Tags</td>
                        <td class="muted">@t.Notes</td>
                        @if (Model.IsAdmin) { <td><code>@Schnapp.Contracts.Uuid7Text.Format(t.Id)</code></td> }
                        <td class="actions">
                            <a class="icon-btn" href="/Customers/Tasks/@Schnapp.Contracts.Uuid7Text.Format(t.Id)"
                               title="Edit @t.Name" aria-label="Edit @t.Name">
                                <partial name="_Icon" model='"edit"' />
                            </a>
                        </td>
                        <td class="actions">
                            @if (t.Id != WellKnownIds.None)
                            {
                                <form method="post" asp-page-handler="DeleteTask" asp-route-id="@Schnapp.Contracts.Uuid7Text.Format(t.Id)" class="inline-form">
                                    <button type="submit" class="icon-btn danger" title="Delete @t.Code" aria-label="Delete @t.Code"
                                            data-confirm="Delete task @t.Code?">
                                        <partial name="_Icon" model='"trash"' />
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.CustomerTasks.Count == 0)
                {
                    <tr><td colspan="6" class="muted">No customer-level tasks.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <dialog id="create-project-dialog" class="form-dialog form-dialog-resizable">
        <form method="post" asp-page-handler="CreateProject" data-disable-on-submit class="form-dialog-body"
              data-code-suggest data-code-existing="@Model.ProjectCodesJson">
            <h2>Add project</h2>
            <div class="entity-fields">
                <div class="entity-col entity-col-left">
                    <div class="field-row">
                        <label asp-for="NewProject.Code">Code</label>
                        <input asp-for="NewProject.Code" data-code-field autocomplete="off"
                               placeholder="auto from name" title="Suggested from name as STEM### (e.g. SD001)" />
                    </div>
                    <div class="field-row">
                        <label asp-for="NewProject.Name">Name</label>
                        <input asp-for="NewProject.Name" data-name-field autofocus />
                    </div>
                    <div class="field-row">
                        <label asp-for="NewProject.Tags">Tags</label>
                        <input asp-for="NewProject.Tags" />
                    </div>
                </div>
                <div class="entity-col entity-col-right">
                    <div class="field-row">
                        <label asp-for="NewProject.Status">Status</label>
                        <select asp-for="NewProject.Status">
                            @foreach (var (value, label) in ListEntityStatus.All)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                    <div class="field-row">
                        <label asp-for="NewProject.ColourCode">Colour</label>
                        <div class="colour-field">
                            <input type="color" value="#5b9fd4" aria-label="Colour swatch" />
                            <input asp-for="NewProject.ColourCode" type="text" placeholder="#rrggbb or name" />
                        </div>
                    </div>
                </div>
                <div class="field-row field-notes-row entity-notes-span">
                    <label asp-for="NewProject.Notes">Notes</label>
                    <textarea asp-for="NewProject.Notes" rows="3"></textarea>
                </div>
            </div>
            <div class="form-dialog-actions">
                <button type="submit" class="btn-with-icon">
                    <partial name="_Icon" model='"plus"' /><span>Create project</span>
                </button>
                <button type="button" class="btn-with-icon secondary" data-close-dialog>
                    <partial name="_Icon" model='"close"' /><span>Cancel</span>
                </button>
            </div>
        </form>
    </dialog>

    <dialog id="create-customer-task-dialog" class="form-dialog form-dialog-resizable">
        <form method="post" asp-page-handler="CreateTask" data-disable-on-submit class="form-dialog-body"
              data-code-suggest data-code-existing="@Model.TaskCodesJson">
            <h2>Add customer task</h2>
            <div class="entity-fields">
                <div class="entity-col entity-col-left">
                    <div class="field-row">
                        <label asp-for="NewTask.Code">Code</label>
                        <input asp-for="NewTask.Code" data-code-field autocomplete="off"
                               placeholder="auto from name" title="Suggested from name as STEM###" />
                    </div>
                    <div class="field-row">
                        <label asp-for="NewTask.Name">Name</label>
                        <input asp-for="NewTask.Name" data-name-field autofocus />
                    </div>
                    <div class="field-row">
                        <label asp-for="NewTask.Tags">Tags</label>
                        <input asp-for="NewTask.Tags" />
                    </div>
                </div>
                <div class="entity-col entity-col-right">
                    <div class="field-row">
                        <label asp-for="NewTask.Status">Status</label>
                        <select asp-for="NewTask.Status">
                            @foreach (var (value, label) in ListEntityStatus.All)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                    <div class="field-row">
                        <label asp-for="NewTask.ColourCode">Colour</label>
                        <div class="colour-field">
                            <input type="color" value="#5b9fd4" aria-label="Colour swatch" />
                            <input asp-for="NewTask.ColourCode" type="text" placeholder="#rrggbb or name" />
                        </div>
                    </div>
                </div>
                <div class="field-row field-notes-row entity-notes-span">
                    <label asp-for="NewTask.Notes">Notes</label>
                    <textarea asp-for="NewTask.Notes" rows="3"></textarea>
                </div>
            </div>
            <div class="form-dialog-actions">
                <button type="submit" class="btn-with-icon">
                    <partial name="_Icon" model='"plus"' /><span>Create task</span>
                </button>
                <button type="button" class="btn-with-icon secondary" data-close-dialog>
                    <partial name="_Icon" model='"close"' /><span>Cancel</span>
                </button>
            </div>
        </form>
    </dialog>
}
